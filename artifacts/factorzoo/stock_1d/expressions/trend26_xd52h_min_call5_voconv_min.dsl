rwk26 = RANK(TS_MEAN($ret@1w, 26))
d52h = RANK(DIVIDE($adj_close, TS_MAX($adj_close, 250)))
r5 = RANK(TS_MEAN($ret, 5))
v20 = TS_STD($ret, 20)
v250 = TS_STD($ret, 250)
vconv = RANK(DIVIDE(v20, v250))
trend = MIN(rwk26, d52h)
score = MIN(trend, SUBTRACT(1, r5), SUBTRACT(1, vconv))
CS_NEUTRALIZE(CS_ZSCORE(score), CS_BUCKET(LOG($float_cap), 10))
