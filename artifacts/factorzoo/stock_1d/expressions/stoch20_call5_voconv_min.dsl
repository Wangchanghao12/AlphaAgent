hi20 = TS_MAX($high, 20)
lo20 = TS_MIN($low, 20)
stoch = DIVIDE(SUBTRACT($close, lo20), SUBTRACT(hi20, lo20))
r5 = RANK(TS_MEAN($ret, 5))
v20 = TS_STD($ret, 20)
v250 = TS_STD($ret, 250)
vconv = RANK(DIVIDE(v20, v250))
score = MIN(RANK(stoch), SUBTRACT(1, r5), SUBTRACT(1, vconv))
CS_NEUTRALIZE(CS_ZSCORE(score), CS_BUCKET(LOG($float_cap), 10))
