vol20 = TS_STD($ret, 20)
vvc = TS_CORR(vol20, $volume, 60)
lr = SUBTRACT(LOG($high), LOG($low))
p20 = TS_STD(lr, 20)
p240 = TS_STD(lr, 240)
pt = DIVIDE(ADD(p20, 1e-9), ADD(p240, 1e-9))
capk = CS_BUCKET(LOG($float_cap), 10)
v1 = CS_NEUTRALIZE(CS_ZSCORE(CS_WINSORIZE(NEG(vvc), 0.01, 0.99)), capk)
v2 = CS_NEUTRALIZE(CS_ZSCORE(CS_WINSORIZE(NEG(pt), 0.01, 0.99)), capk)
FILLNA(ADD(v1, v2), 0.0)
