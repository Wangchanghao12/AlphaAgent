vol20 = TS_STD($ret, 20)
vol240 = TS_STD($ret, 240)
tr = DIVIDE(ADD(vol20, 1e-9), ADD(vol240, 1e-9))
hl = DIVIDE(SUBTRACT($high, $low), $adj_close)
pk20 = TS_STD(hl, 20)
pk240 = TS_STD(hl, 240)
ptr = DIVIDE(ADD(pk20, 1e-9), ADD(pk240, 1e-9))
capk = CS_BUCKET(LOG($float_cap), 10)
trn = CS_NEUTRALIZE(CS_ZSCORE(CS_WINSORIZE(NEG(tr), 0.01, 0.99)), capk)
ptrn = CS_NEUTRALIZE(CS_ZSCORE(CS_WINSORIZE(NEG(ptr), 0.01, 0.99)), capk)
FILLNA(ADD(trn, ptrn), 0.0)
