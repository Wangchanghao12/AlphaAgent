vol20 = TS_STD($ret, 20)
vpe = TS_PERMUTATION_ENTROPY(vol20, 40, 4)
hl = DIVIDE(SUBTRACT($high, $low), $adj_close)
pk20 = TS_STD(hl, 20)
pk240 = TS_STD(hl, 240)
ptr = DIVIDE(ADD(pk20, 1e-9), ADD(pk240, 1e-9))
capk = CS_BUCKET(LOG($float_cap), 10)
vpen = CS_NEUTRALIZE(CS_ZSCORE(CS_WINSORIZE(vpe, 0.01, 0.99)), capk)
ptrn = CS_NEUTRALIZE(CS_ZSCORE(CS_WINSORIZE(NEG(ptr), 0.01, 0.99)), capk)
FILLNA(ADD(vpen, ptrn), 0.0)
