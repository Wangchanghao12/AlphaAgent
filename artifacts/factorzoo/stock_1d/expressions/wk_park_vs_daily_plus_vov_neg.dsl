wk_hi = TS_MAX($high@1w, 4)
wk_lo = TS_MIN($low@1w, 4)
wk_pk = TS_MEAN(POW(LOG(DIVIDE(wk_hi, wk_lo)), 2), 4)
dk_hl = LOG(DIVIDE($high, $low))
dk_pk = TS_MEAN(POW(dk_hl, 2), 20)
wpd = RANK(CS_WINSORIZE(DIVIDE(wk_pk, ADD(dk_pk, 1e-12)), 0.01, 0.99))
rv15 = TS_STD($ret, 15)
vov = TS_STD(rv15, 60)
lowv = RANK(CS_WINSORIZE(NEG(vov), 0.01, 0.99))
CS_WINSORIZE(ADD(MULTIPLY(0.5, wpd), MULTIPLY(0.5, lowv)), 0.01, 0.99)
