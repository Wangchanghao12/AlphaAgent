rv20 = TS_STD($ret, 20)
sm = TS_MEAN(rv20, 120)
sd = TS_STD(rv20, 120)
z = DIVIDE(SUBTRACT(rv20, sm), ADD(sd, 0.000001))
vd_r = RANK(CS_NEUTRALIZE(CS_WINSORIZE(z, 0.01, 0.99), CS_BUCKET(LOG($float_cap), 10)))
rv15 = TS_STD($ret, 15)
vov = TS_STD(rv15, 60)
vov_r = RANK(CS_NEUTRALIZE(CS_WINSORIZE(vov, 0.01, 0.99), CS_BUCKET(LOG($float_cap), 10)))
NEG(ADD(vd_r, vov_r))
