wma20 = WMA($ret, 20)
vol20 = TS_STD($ret, 20)
ram = RANK(DIVIDE(wma20, vol20))
r10 = RANK(TS_MEAN($ret, 10))
v20 = TS_STD($ret, 20)
v250 = TS_STD($ret, 250)
vconv = RANK(DIVIDE(v20, v250))
score = MIN(ram, SUBTRACT(1, r10), SUBTRACT(1, vconv))
CS_NEUTRALIZE(CS_ZSCORE(score), CS_BUCKET(LOG($float_cap), 10))
