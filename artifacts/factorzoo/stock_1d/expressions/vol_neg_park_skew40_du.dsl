v60 = TS_STD($ret, 60)
vp = TS_CORR(v60, DELAY(v60, 1), 60)
vp_r = RANK(CS_WINSORIZE(vp, 0.01, 0.99))
park60 = TS_STD(LOG(DIVIDE($high, $low)), 60)
park60_r = RANK(CS_WINSORIZE(park60, 0.01, 0.99))
skew40_r = RANK(CS_WINSORIZE(TS_SKEW($ret, 40), 0.01, 0.99))
down = TS_STD(MIN($ret, 0), 60)
up = TS_STD(MAX($ret, 0), 60)
du = DIVIDE(down, up)
du_r = RANK(CS_WINSORIZE(du, 0.01, 0.99))
comp = ADD(ADD(ADD(NEG(vp_r), NEG(park60_r)), NEG(skew40_r)), du_r)
resid = CS_NEUTRALIZE(comp, CS_BUCKET(LOG($float_cap), 10))
FILLNA(resid, 0)
