resi = RESI(LOG($adj_close), 60)
mom120 = TS_MEAN($ret, 120)
mom20 = TS_MEAN($ret, 20)
fast = ADD(NEG(CS_ZSCORE(resi)), CS_ZSCORE(SUBTRACT(mom120, mom20)))
ma_w13 = TS_MEAN($adj_close@1w, 13)
ma_w39 = TS_MEAN($adj_close@1w, 39)
wkg = CS_ZSCORE(SUBTRACT(ma_w39, ma_w13) / ma_w13)
raw = ADD(fast, MULTIPLY(wkg, 0.5))
CS_WINSORIZE(raw, 0.02, 0.98)
