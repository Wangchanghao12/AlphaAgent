    TS_RANK, TS_STD, TS_SUM, TS_VAR, TS_ZSCORE, WMA, WR, ZIGZAG_BOTTOM, ZIGZAG_BOTTOM_DAYS, ZIGZAG_TOP, ZIGZAG_TOP_DAYS, ZSCORE
