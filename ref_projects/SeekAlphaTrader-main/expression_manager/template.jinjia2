import pandas as pd
import numpy as np
from expression_manager.expr_parser import parse_expression
from expression_manager.function_lib import *


def calculate_factor(expr: str, name: str):
    # Stock DataFrame
    df = pd.read_csv('.debug/debug_df.csv', index_col=[0, 1], parse_dates=True)

    # parse expression
    expr = parse_expression(expr)

    # replace '$var_name' by 'df['$var_name']' to get the real data
    for col in df.columns:
        expr = expr.replace(f"${col}", f"df['{col}']")
    
    # calculate the factor
    df[name] = eval(expr)

    df[name].to_pickle('.debug/result_df.pkl')
    print("因子表达式计算结果已保存到 .debug/result_df.pkl")

# Input factor expression. Do NOT use the variable format like "df['$xxx']" in factor expressions. Instead, you should use "$xxx". 
expr = "{{ expression }}"
name = "{{ factor_name }}"
calculate_factor(expr, name)




    