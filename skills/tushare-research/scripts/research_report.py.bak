""")
        
        # 如果保存了MD文件，打印文件路径
        if save_md and md_file_path:
            print(f"\n---\n\n✅ 研报已保存至: `{md_file_path}`\n")
    
    finally:
        # 恢复标准输出
        if output_capture:
            sys.stdout = old_stdout
            output_capture.close()
            return md_file_path
    
    return None


def get_industry_index_data(ts_code):
    """获取所属行业指数数据"""
    try:
        import tushare as ts
        token = os.environ.get('TUSHARE_TOKEN', '')
        if not token:
            return None
        pro = ts.pro_api(token)
        
        # 获取股票基本信息
        stock_basic = pro.stock_basic(ts_code=ts_code)
        if stock_basic.empty:
            return None
        
        industry = stock_basic.iloc[0]['industry']
        
        # 尝试获取行业指数数据
        # Tushare 行业指数代码格式：如 885001.TI（同花顺行业）
        # 先尝试获取申万行业指数
        try:
            # 获取行业分类
            industry_data = pro.stock_company(ts_code=ts_code)
            if not industry_data.empty:
                sw_industry = industry_data.iloc[0].get('sw_industry', '')
            else:
                sw_industry = industry
        except:
            sw_industry = industry
        
        # 获取最近交易日
        trade_date = datetime.now().strftime('%Y%m%d')
        
        # 尝试获取一些常用行业指数的数据
        # 这里返回行业名称和一些通用信息
        return {
            'industry': industry,
            'sw_industry': sw_industry,
            'trade_date': trade_date
        }
    except Exception as e:
        return None


def print_industry_index_section(ts_code):
    """打印行业指数走势部分 - 自动获取数据"""
    industry_data = get_industry_index_data(ts_code)
    
    print("\n**行业指数走势**\n")
    
    if industry_data:
        industry = industry_data.get('industry', '未知')
        sw_industry = industry_data.get('sw_industry', '')
        
        print(f"**所属行业**: {industry}")
        if sw_industry and sw_industry != industry:
            print(f"**申万行业**: {sw_industry}")
        print()
        
        # 打印行业数据表格框架（数据由Tushare行业指数接口获取）
        print("| 行业指数 | 当前点位 | 涨跌 | 涨跌幅 | 趋势 |")
        print("|----------|----------|------|--------|------|")
        
        # 尝试获取行业指数数据
        try:
            import tushare as ts
            token = os.environ.get('TUSHARE_TOKEN', '')
            if token:
                pro = ts.pro_api(token)
                # 获取最近交易日
                today = datetime.now().strftime('%Y%m%d')
                
                # 尝试获取同花顺行业指数（如果有权限）
                try:
                    # 行业代码映射（简化版，实际需要更完善的映射）
                    industry_map = {
                        '化工原料': '885001',
                        '电气设备': '885003',
                        '银行': '885008',
                        '半导体': '885008',
                        '汽车配件': '885005',
                        '专用机械': '885002',
                        '元器件': '885004',
                    }
                    
                    ths_code = industry_map.get(industry, '')
                    if ths_code:
                        ths_daily = pro.ths_daily(ts_code=ths_code + '.TI', start_date=today, end_date=today)
                        if not ths_daily.empty:
                            row = ths_daily.iloc[0]
                            close = row.get('close', 0)
                            pre_close = row.get('pre_close', 0)
                            change = close - pre_close if pre_close else 0
                            pct_change = (change / pre_close * 100) if pre_close else 0
                            trend = '↑' if change > 0 else ('↓' if change < 0 else '→')
                            print(f"| {industry} | {close:.2f} | {change:+.2f} | {pct_change:+.2f}% | {trend} |")
                        else:
                            print(f"| {industry} | 数据获取中... | - | - | → |")
                    else:
                        print(f"| {industry} | 数据获取中... | - | - | → |")
                except Exception as e:
                    print(f"| {industry} | 数据获取中... | - | - | → |")
            else:
                print(f"| {industry} | 需配置TUSHARE_TOKEN | - | - | → |")
        except Exception as e:
            print(f"| {industry} | 数据获取中... | - | - | → |")
        
        print()
        print("> 📌 **说明**：行业指数数据来自 Tushare `ths_daily` 接口或申万行业指数")
        print("> 如需完整行业指数分析，请确保Tushare Pro权限包含行业指数数据")
        
    else:
        print("> ⚠️ 无法获取行业信息，请检查Tushare Token配置")
    
    print()


        # 一、宏观分析
        print("\n## 一、宏观分析\n")
        print("### 1.1 市场走势（A股+行业指数）\n")
        fund_output = run_script_and_capture('fundamental_analysis.py', ts_code, trade_date)
        # 精确提取宏观分析部分（只保留【大盘走势】到【宏观关注点】的内容）
        if '【大盘走势】' in fund_output:
            # 找到【大盘走势】的位置
            macro_start = fund_output.find('【大盘走势】')
            macro_section = fund_output[macro_start:]
            # 在多个可能的结束点截断
            end_markers = ['📈 公司基本面', '【公司概况】', '---\n📈 公司']
            for marker in end_markers:
                if marker in macro_section:
                    macro_section = macro_section.split(marker)[0]
                    break
            print(macro_section)
        else:
            print(fund_output)
        
        # 添加行业指数走势 - 自动获取
        print_industry_index_section(ts_code)
        
        print("\n### 1.2 政策分析\n")
    """获取所属行业指数数据"""
    try:
        import tushare as ts
        token = os.environ.get('TUSHARE_TOKEN', '')
        if not token:
            return None
        pro = ts.pro_api(token)
        
        # 获取股票基本信息
        stock_basic = pro.stock_basic(ts_code=ts_code)
        if stock_basic.empty:
            return None
        
        industry = stock_basic.iloc[0]['industry']
        
        # 尝试获取行业指数数据
        # Tushare 行业指数代码格式：如 885001.TI（同花顺行业）
        # 先尝试获取申万行业指数
        try:
            # 获取行业分类
            industry_data = pro.stock_company(ts_code=ts_code)
            if not industry_data.empty:
                sw_industry = industry_data.iloc[0].get('sw_industry', '')
            else:
                sw_industry = industry
        except:
            sw_industry = industry
        
        # 获取最近交易日
        trade_date = datetime.now().strftime('%Y%m%d')
        
        # 尝试获取一些常用行业指数的数据
        # 这里返回行业名称和一些通用信息
        return {
            'industry': industry,
            'sw_industry': sw_industry,
            'trade_date': trade_date
        }
    except Exception as e:
        return None


def print_industry_index_section(ts_code):
    """打印行业指数走势部分 - 自动获取数据"""
    industry_data = get_industry_index_data(ts_code)
    
    print("\n**行业指数走势**\n")
    
    if industry_data:
        industry = industry_data.get('industry', '未知')
        sw_industry = industry_data.get('sw_industry', '')
        
        print(f"**所属行业**: {industry}")
        if sw_industry and sw_industry != industry:
            print(f"**申万行业**: {sw_industry}")
        print()
        
        # 打印行业数据表格框架（数据由Tushare行业指数接口获取）
        print("| 行业指数 | 当前点位 | 涨跌 | 涨跌幅 | 趋势 |")
        print("|----------|----------|------|--------|------|")
        
        # 尝试获取行业指数数据
        try:
            import tushare as ts
            token = os.environ.get('TUSHARE_TOKEN', '')
            if token:
                pro = ts.pro_api(token)
                # 获取最近交易日
                today = datetime.now().strftime('%Y%m%d')
                
                # 尝试获取同花顺行业指数（如果有权限）
                try:
                    # 行业代码映射（简化版，实际需要更完善的映射）
                    industry_map = {
                        '化工原料': '885001',
                        '电气设备': '885003',
                        '银行': '885008',
                        '半导体': '885008',
                        '汽车配件': '885005',
                        '专用机械': '885002',
                        '元器件': '885004',
                    }
                    
                    ths_code = industry_map.get(industry, '')
                    if ths_code:
                        ths_daily = pro.ths_daily(ts_code=ths_code + '.TI', start_date=today, end_date=today)
                        if not ths_daily.empty:
                            row = ths_daily.iloc[0]
                            close = row.get('close', 0)
                            pre_close = row.get('pre_close', 0)
                            change = close - pre_close if pre_close else 0
                            pct_change = (change / pre_close * 100) if pre_close else 0
                            trend = '↑' if change > 0 else ('↓' if change < 0 else '→')
                            print(f"| {industry} | {close:.2f} | {change:+.2f} | {pct_change:+.2f}% | {trend} |")
                        else:
                            print(f"| {industry} | 数据获取中... | - | - | → |")
                    else:
                        print(f"| {industry} | 数据获取中... | - | - | → |")
                except Exception as e:
                    print(f"| {industry} | 数据获取中... | - | - | → |")
            else:
                print(f"| {industry} | 需配置TUSHARE_TOKEN | - | - | → |")
        except Exception as e:
            print(f"| {industry} | 数据获取中... | - | - | → |")
        
        print()
        print("> 📌 **说明**：行业指数数据来自 Tushare `ths_daily` 接口或申万行业指数")
        print("> 如需完整行业指数分析，请确保Tushare Pro权限包含行业指数数据")
        
    else:
        print("> ⚠️ 无法获取行业信息，请检查Tushare Token配置")
    
    print()
        
