#!/usr/bin/env python3
"""
A股综合投研分析 - 整合七维分析框架
改进版：更好的Markdown格式输出
"""
import sys
import os
import subprocess
import re
from datetime import datetime
from io import StringIO

# 添加技能根目录到路径
sys.path.insert(0, os.path.dirname(os.path.dirname(os.path.abspath(__file__))))


def search_with_kimi(query, limit=5):
    """
    使用内置 kimi_search 工具搜索（需在 Agent 环境中运行）
    """
    try:
        # 尝试导入内置工具
        from tools import kimi_search
        return kimi_search(query, limit=limit)
    except:
        # 如果不可用，返回空列表
        return []


class OutputCapture:
    """输出捕获器，同时打印到控制台并保存到文件"""
    def __init__(self, save_to_file=False, file_path=None):
        self.save_to_file = save_to_file
        self.file_path = file_path
        self.buffer = StringIO()
        self.file_handle = None
        if save_to_file and file_path:
            os.makedirs(os.path.dirname(file_path), exist_ok=True)
            self.file_handle = open(file_path, 'w', encoding='utf-8')
    
    def write(self, text):
        """写入输出"""
        self.buffer.write(text)
        if self.file_handle:
            self.file_handle.write(text)
            self.file_handle.flush()
        sys.__stdout__.write(text)
        sys.__stdout__.flush()
    
    def flush(self):
        """刷新缓冲区"""
        if self.file_handle:
            self.file_handle.flush()
        sys.__stdout__.flush()
    
    def close(self):
        """关闭文件"""
        if self.file_handle:
            self.file_handle.close()
    
    def get_content(self):
        """获取内容"""
        return self.buffer.getvalue()


def run_script_and_capture(script_name, ts_code, trade_date=None):
    """运行脚本并捕获输出"""
    script_dir = os.path.dirname(os.path.abspath(__file__))
    args = ['python3', os.path.join(script_dir, script_name), ts_code]
    if trade_date:
        args.append(trade_date)
    
    result = subprocess.run(args, capture_output=True, text=True)
    return result.stdout + result.stderr


def extract_key_metrics(outputs):
    """从各维度输出中提取关键指标用于生成投研结论"""
    metrics = {
        'close_price': 'N/A',
        'pe': 'N/A',
        'pb': 'N/A',
        'roe': 'N/A',
        'market_cap': 'N/A',
        'name': 'N/A',
        'industry': 'N/A',
        'support': 'N/A',
        'resistance': 'N/A',
        'trend': 'N/A',
        'rsi': 'N/A',
        'net_inflow': 0,
        'sentiment': 'N/A',
        'report_count': 0,
        'signals': {},
        'reasons': {},
        'expectation_signal': '→',  # 市场预期信号
        'expectation_reason': '',    # 市场预期原因
        'investment_type': '',       # 投资类型
        'fair_pe_low': 0,           # 合理PE区间下限
        'fair_pe_high': 0,          # 合理PE区间上限
        'key_risks': []             # 关键风险列表
    }
    
    fund_output = outputs.get('fundamental', '')
    tech_output = outputs.get('technical', '')
    cap_output = outputs.get('capital', '')
    sent_output = outputs.get('sentiment', '')
    news_output = outputs.get('news', '')
    
    # 从基本面提取
    for line in fund_output.split('\n'):
        if '市盈率(PE-TTM):' in line:
            try:
                metrics['pe'] = line.split(':')[1].strip().split()[0]
            except:
                pass
        elif '市净率(PB):' in line:
            try:
                metrics['pb'] = line.split(':')[1].strip().split()[0]
            except:
                pass
        elif '总市值:' in line:
            try:
                metrics['market_cap'] = line.split(':')[1].strip()
            except:
                pass
        elif '净资产收益率(ROE):' in line:
            try:
                metrics['roe'] = line.split(':')[1].strip().split()[0]
            except:
                pass
        elif '公司名称:' in line:
            try:
                metrics['name'] = line.split(':')[1].strip()
            except:
                pass
        elif '所属行业:' in line:
            try:
                metrics['industry'] = line.split(':')[1].strip()
            except:
                pass
        elif '收盘:' in line or '收盘价:' in line:
            try:
                metrics['close_price'] = line.split(':')[1].strip().split()[0]
            except:
                pass
    
    # 从技术面提取
    for line in tech_output.split('\n'):
        if '趋势:' in line or '趋势判断:' in line:
            if '多头' in line:
                metrics['trend'] = '多头'
            elif '空头' in line:
                metrics['trend'] = '空头'
            elif '震荡' in line:
                metrics['trend'] = '震荡'
        elif '近20日低点:' in line:
            try:
                metrics['support'] = line.split(':')[1].strip().split()[0]
            except:
                pass
        elif '近20日高点:' in line:
            try:
                metrics['resistance'] = line.split(':')[1].strip().split()[0]
            except:
                pass
        elif 'RSI(' in line and ':' in line:
            try:
                metrics['rsi'] = line.split(':')[1].strip().split()[0]
            except:
                pass
    
    # 从资金面提取
    for line in cap_output.split('\n'):
        if '净流入:' in line and '汇总' not in line and '【' not in line:
            try:
                value_str = line.split(':')[1].strip().split()[0]
                metrics['net_inflow'] = float(value_str.replace('+', ''))
            except:
                pass
    
    # 从情绪面提取
    for line in sent_output.split('\n'):
        if '整体情绪:' in line or '情绪判断:' in line:
            try:
                metrics['sentiment'] = line.split(':')[1].strip().split()[0]
            except:
                pass
    
    # 从消息面提取
    for line in news_output.split('\n'):
        if '研报数量:' in line or '近6个月研报数量:' in line:
            try:
                metrics['report_count'] = int(line.split(':')[1].strip().split()[0])
            except:
                pass
    
    # 从市场预期分析提取
    exp_output = outputs.get('expectation', '')
    for line in exp_output.split('\n'):
        if '当前状态:' in line or '估值评估:' in line:
            try:
                if '高估' in line:
                    metrics['expectation_signal'] = '↓'
                elif '低估' in line:
                    metrics['expectation_signal'] = '↑'
                else:
                    metrics['expectation_signal'] = '→'
            except:
                pass
        elif '评估说明:' in line:
            try:
                metrics['expectation_reason'] = line.split(':')[1].strip()
            except:
                pass
        elif '类型:' in line and '投资' in line:
            try:
                metrics['investment_type'] = line.split(':')[1].strip()
            except:
                pass
        elif '合理PE区间:' in line:
            try:
                pe_range = line.split(':')[1].strip()
                if '-' in pe_range:
                    parts = pe_range.replace('倍', '').split('-')
                    metrics['fair_pe_low'] = float(parts[0])
                    metrics['fair_pe_high'] = float(parts[1])
            except:
                pass
    
    # 提取关键风险
    if '【关键风险】' in exp_output:
        risk_section = exp_output.split('【关键风险】')[1].split('【')[0] if '【' in exp_output.split('【关键风险】')[1] else exp_output.split('【关键风险】')[1]
        for line in risk_section.split('\n'):
            if '⚠️' in line or '-' in line or '•' in line:
                risk = line.replace('⚠️', '').replace('-', '').replace('•', '').strip()
                if risk and len(risk) > 3:
                    metrics['key_risks'].append(risk)
    
    # 生成各维度信号（五维框架）
    metrics['signals'], metrics['reasons'] = generate_dimension_signals(metrics, fund_output, tech_output, cap_output, news_output)
    
    return metrics


def generate_dimension_signals(metrics, fund_output, tech_output, cap_output, news_output):
    """生成各维度信号 - 五维框架"""
    signals = {}
    reasons = {}
    
    # 1. 宏观/基本面信号（已包含大盘环境）
    roe_str = metrics.get('roe', '0')
    try:
        roe_val = float(roe_str.replace('%', ''))
    except:
        roe_val = 0
    
    if '改善' in fund_output and roe_val > 10:
        signals['fundamental'] = '↑'
        reasons['fundamental'] = f"ROE {roe_val}%行业领先，财务指标改善"
    elif '改善' in fund_output or roe_val > 8:
        signals['fundamental'] = '→'
        reasons['fundamental'] = "财务稳健，业绩平稳"
    else:
        signals['fundamental'] = '→'
        reasons['fundamental'] = "盈利能力偏弱，需观察改善"
    
    # 2. 商业模式/竞争格局信号（从business_output提取）
    # 这里简化处理，实际应从business_output解析
    signals['business'] = '→'
    reasons['business'] = "护城河中等，竞争格局稳定"
    
    # 3. 资金面信号
    net_inflow = metrics.get('net_inflow', 0)
    if net_inflow > 50000:
        signals['capital'] = '↑'
        reasons['capital'] = f"资金大幅净流入，主力看好"
    elif net_inflow < -50000:
        signals['capital'] = '↓↓'
        reasons['capital'] = f"资金大幅净流出，主力撤退"
    elif net_inflow < 0:
        signals['capital'] = '↓'
        reasons['capital'] = f"资金净流出，谨慎观望"
    else:
        signals['capital'] = '→'
        reasons['capital'] = "资金流向平稳"
    
    # 4. 技术面信号（包含同行业对比）
    trend = metrics.get('trend', '')
    rsi_str = metrics.get('rsi', '50')
    try:
        rsi_val = float(rsi_str)
    except:
        rsi_val = 50
    
    if '多头' in trend:
        signals['technical'] = '↑'
        reasons['technical'] = "多头排列，趋势向上"
    elif '空头' in trend:
        if rsi_val < 30:
            signals['technical'] = '↓↓'
            reasons['technical'] = f"空头排列，RSI {rsi_val}严重超卖"
        else:
            signals['technical'] = '↓'
            reasons['technical'] = "空头排列，趋势向下"
    else:
        signals['technical'] = '→'
        reasons['technical'] = "震荡整理，方向不明"
    
    # 5. 消息面/估值预期信号
    report_count = metrics.get('report_count', 0)
    exp_signal = metrics.get('expectation_signal', '→')
    
    if exp_signal == '↑':
        signals['expectation'] = '↑'
        reasons['expectation'] = "估值预期向好，题材丰富"
    elif exp_signal == '↓':
        signals['expectation'] = '↓'
        reasons['expectation'] = "估值预期悲观，需警惕"
    else:
        signals['expectation'] = '→'
        reasons['expectation'] = "估值预期待观察"
    
    return signals, reasons


def generate_conclusion(metrics):
    """生成投研结论"""
    signals = metrics['signals']
    
    # 统计信号方向
    up_count = sum(1 for s in signals.values() if '↑' in s)
    down_count = sum(1 for s in signals.values() if '↓' in s)
    neutral_count = sum(1 for s in signals.values() if s == '→')
    
    # 考虑市场预期的评级调整
    exp_signal = metrics.get('expectation_signal', '→')
    investment_type = metrics.get('investment_type', '')
    
    # 根据投资类型调整仓位建议
    if "主题投资" in investment_type:
        type_adjustment = "(主题投资特性，建议控制仓位<15%)"
        base_position_factor = 0.5  # 主题投资仓位减半
    elif "成长股" in investment_type:
        type_adjustment = "(成长股特性，验证业绩后加仓)"
        base_position_factor = 0.8
    else:
        type_adjustment = ""
        base_position_factor = 1.0
    
    # 五维一致性判断（含市场预期）
    if up_count >= 4:
        consistency = "五维共振向上，强烈看多"
        overall_rating = "买入"
        position = f"{int(30*base_position_factor)}-{int(50*base_position_factor)}% {type_adjustment}"
    elif up_count >= 3:
        consistency = "多数维度向上，趋势较明确"
        overall_rating = "增持"
        position = f"{int(20*base_position_factor)}-{int(30*base_position_factor)}% {type_adjustment}"
    elif down_count >= 4:
        consistency = "多数维度向下，回避为主"
        overall_rating = "减持"
        position = "0-5%"
    elif down_count >= 3:
        consistency = "信号偏空，谨慎观望"
        overall_rating = "中性偏空"
        position = f"0-{int(10*base_position_factor)}%"
    elif down_count >= 2 and up_count >= 2:
        consistency = "信号分歧，等待方向明确"
        overall_rating = "中性"
        position = f"{int(5*base_position_factor)}-{int(15*base_position_factor)}%"
    else:
        consistency = "趋势不明，等待信号统一"
        overall_rating = "中性"
        position = f"0-{int(10*base_position_factor)}%"
    
    # 计算关键价位
    close_price = metrics.get('close_price', 'N/A')
    support = metrics.get('support', 'N/A')
    resistance = metrics.get('resistance', 'N/A')
    
    try:
        close_val = float(close_price)
        support_val = float(support) if support != 'N/A' else close_val * 0.9
        resistance_val = float(resistance) if resistance != 'N/A' else close_val * 1.1
        
        target = resistance_val * 1.15
        stop_loss = support_val * 0.95
        entry_low = close_val * 0.95
        entry_high = close_val * 1.02
        
        upside = (target - close_val) / close_val * 100
        downside = (close_val - stop_loss) / close_val * 100
    except:
        close_val = support_val = resistance_val = target = stop_loss = entry_low = entry_high = 0
        upside = downside = 0
    
    # 剧本概率判断
    trend = metrics.get('trend', '')
    net_inflow = metrics.get('net_inflow', 0)
    rsi_str = metrics.get('rsi', '50')
    try:
        rsi_val = float(rsi_str)
    except:
        rsi_val = 50
    
    if '空头' in trend and net_inflow < -50000:
        scenario_probs = {"A": "低", "B": "中", "C": "中", "D": "中高", "E": "推荐"}
    elif '多头' in trend and net_inflow > 0:
        scenario_probs = {"A": "推荐", "B": "中", "C": "低", "D": "低", "E": "低"}
    elif rsi_val < 30:
        scenario_probs = {"A": "低", "B": "推荐", "C": "中", "D": "中", "E": "中"}
    else:
        scenario_probs = {"A": "低", "B": "中", "C": "推荐", "D": "中", "E": "中"}
    
    return {
        'consistency': consistency,
        'overall_rating': overall_rating,
        'position': position,
        'close_price': close_price,
        'pe': metrics.get('pe', 'N/A'),
        'pb': metrics.get('pb', 'N/A'),
        'roe': metrics.get('roe', 'N/A'),
        'market_cap': metrics.get('market_cap', 'N/A'),
        'support': f"{support_val:.2f}" if isinstance(support_val, float) else 'N/A',
        'resistance': f"{resistance_val:.2f}" if isinstance(resistance_val, float) else 'N/A',
        'target': f"{target:.2f}" if isinstance(target, float) else 'N/A',
        'stop_loss': f"{stop_loss:.2f}" if isinstance(stop_loss, float) else 'N/A',
        'entry_low': f"{entry_low:.2f}" if isinstance(entry_low, float) else 'N/A',
        'entry_high': f"{entry_high:.2f}" if isinstance(entry_high, float) else 'N/A',
        'upside': f"{upside:.1f}" if isinstance(upside, float) else 'N/A',
        'downside': f"{downside:.1f}" if isinstance(downside, float) else 'N/A',
        'scenario_probs': scenario_probs,
        'signals': signals,
        'reasons': metrics['reasons'],
        'up_count': up_count,
        'down_count': down_count,
        'neutral_count': neutral_count,
        'name': metrics.get('name', 'N/A'),
        'industry': metrics.get('industry', 'N/A'),
        'trend': metrics.get('trend', 'N/A'),
        'rsi': metrics.get('rsi', 'N/A'),
        'sentiment': metrics.get('sentiment', 'N/A'),
        'report_count': metrics.get('report_count', 0),
        'investment_type': metrics.get('investment_type', ''),
        'fair_pe_low': metrics.get('fair_pe_low', 'N/A'),
        'fair_pe_high': metrics.get('fair_pe_high', 'N/A'),
        'key_risks': metrics.get('key_risks', [])
    }


def print_conclusion_section(conclusion):
    """打印投研结论部分 - 修复后的Markdown格式"""
    signals = conclusion['signals']
    reasons = conclusion['reasons']
    
    print(f"""
## 📋 投研结论与交易预案

### 五维交叉验证

| 分析维度 | 信号 | 关键依据 |
|:---------|:----:|:---------|
| 1.宏观/基本面 | {signals.get('fundamental', '→')} | {reasons.get('fundamental', '数据待观察')} |
| 2.商业模式/竞争格局 | {signals.get('business', '→')} | {reasons.get('business', '护城河中等')} |
| 3.资金面 | {signals.get('capital', '→')} | {reasons.get('capital', '资金流向平稳')} |
| 4.估值预期/消息面 | {signals.get('expectation', '→')} | {reasons.get('expectation', '估值预期待观察')} |
| 5.技术面 | {signals.get('technical', '→')} | {reasons.get('technical', '趋势待观察')} |

> **注**：
> - 宏观/基本面维度已综合评估大盘环境、公司财务指标
> - 商业模式/竞争格局维度评估护城河深度与行业地位
> - 估值预期/消息面维度包含概念题材、业绩预期、新闻资讯
> - 技术面维度包含价格走势与关键技术位

**一致性判断**：{conclusion['consistency']}
- 向上维度: {conclusion['up_count']}个 | 向下维度: {conclusion['down_count']}个 | 中性维度: {conclusion['neutral_count']}个

### 综合评级：{conclusion['overall_rating']}

| 指标 | 数值 |
|:-----|:-----|
| 当前股价 | {conclusion['close_price']}元 |
| PE-TTM | {conclusion['pe']} |
| PB | {conclusion['pb']} |
| ROE | {conclusion['roe']} |
| 市值 | {conclusion['market_cap']} |
| 投资类型 | {conclusion.get('investment_type', '待评估')} |

### 核心逻辑摘要

1. **公司质地**: {conclusion['name']} ({conclusion['industry']})
   - 估值水平: PE {conclusion['pe']}倍，PB {conclusion['pb']}倍
   - 盈利能力: ROE {conclusion['roe']}
   - 投资类型: {conclusion.get('investment_type', '待评估')}
   - 详见【一、基本面分析】与【二、商业模式与竞争格局分析】

2. **资金态度**: {reasons.get('capital', '资金流向平稳')}
   - 详见【四、资金面分析】

3. **估值预期**: {reasons.get('expectation', '估值预期待观察')}
   - 合理PE区间: {conclusion.get('fair_pe_low', 'N/A')}-{conclusion.get('fair_pe_high', 'N/A')}倍
   - 详见【五、估值预期分析】与【六、消息面分析】

4. **技术位置**: {conclusion['trend']}排列，RSI {conclusion['rsi']}
   - 关键位置: 支撑 {conclusion['support']}元 / 压力 {conclusion['resistance']}元
   - 详见【七、技术面分析】

### 交易预案

#### 剧本A - 上涨突破 (概率: {conclusion['scenario_probs']['A']})
- **触发条件**: 放量突破{conclusion['resistance']}元压力位，资金净流入转正
- **目标价位**: {conclusion['target']}元 (上涨空间 {conclusion['upside']}%)
- **止损价位**: 跌破{conclusion['resistance']}元或MA5拐头向下
- **仓位建议**: 30-50% (趋势确认后加仓)
- **适用场景**: 多维共振向上，趋势明确

#### 剧本B - 回调低吸 (概率: {conclusion['scenario_probs']['B']})
- **触发条件**: 回踩{conclusion['support']}元支撑位企稳
- **目标价位**: {conclusion['resistance']}元
- **止损价位**: 跌破{conclusion['support']}元且放量
- **仓位建议**: 20-30% (分批建仓)
- **适用场景**: 中长期看好，短期超卖需消化

#### 剧本C - 震荡整理 (概率: {conclusion['scenario_probs']['C']})
- **震荡区间**: {conclusion['support']}元 - {conclusion['resistance']}元
- **操作策略**: 高抛低吸，或观望等待方向选择
- **仓位建议**: 10-20% (轻仓参与)
- **适用场景**: 趋势不明，等待催化剂

#### 剧本D - 下跌破位 (概率: {conclusion['scenario_probs']['D']})
- **触发条件**: 放量跌破{conclusion['support']}元支撑位
- **目标价位**: 下一支撑位或技术测量
- **止损/减仓**: 跌破即减仓，反弹不过压力位清仓
- **仓位建议**: 减仓至5%以下或空仓
- **适用场景**: 趋势转空，回避为主

#### 剧本E - 观望等待 (概率: {conclusion['scenario_probs']['E']})
- **触发条件**: 信号分歧，不确定性高
- **关注要点**: 业绩公告/资金流向/技术突破节点
- **介入时机**: 方向明确后右侧介入，或支撑位确认后左侧布局
- **仓位建议**: 空仓或极轻仓 (<5%)
- **适用场景**: 宁可错过不做错

### 操作建议

| 项目 | 建议 |
|:-----|:-----|
| **评级** | {conclusion['overall_rating']} |
| **仓位** | 建议 {conclusion['position']} (根据风险承受能力调整) |
| **建仓区间** | {conclusion['entry_low']}元 - {conclusion['entry_high']}元 |
| **目标价位** | {conclusion['target']}元 (上涨空间 {conclusion['upside']}%) |
| **止损价位** | {conclusion['stop_loss']}元 (下跌风险 {conclusion['downside']}%) |
| **盈亏比** | {float(conclusion['upside'])/float(conclusion['downside']) if conclusion['downside'] not in ['N/A', '0'] else 'N/A'}:1 (建议>2:1) |

### 风险提示清单

- [ ] **系统性风险**: 大盘暴跌、黑天鹅事件、全球金融危机
- [ ] **宏观风险**: 经济衰退、通胀失控、货币政策急转弯
- [ ] **行业风险**: 政策调控、技术变革、需求下滑、竞争加剧
- [ ] **公司风险**: 业绩不及预期、管理层变动、重大诉讼、财务造假
- [ ] **流动性风险**: 成交量萎缩、大股东减持、限售股解禁
- [ ] **估值风险**: PE/PB过高、泡沫化、业绩增速无法支撑估值
- [ ] **情绪风险**: 市场恐慌、踩踏卖出、流动性枯竭
- [ ] **预期兑现风险**: 转型/成长预期落空，估值回归

### 跟踪要点与观察窗口

1. **业绩节点**: 下次财报披露时间，关注营收/利润增速是否延续
2. **技术位置**: 关注 {conclusion['support']}元 支撑/ {conclusion['resistance']}元 压力的有效性
3. **资金流向**: 持续跟踪主力资金流向，警惕连续净流出
4. **催化剂**: 政策出台/订单公告/行业会议等
5. **风险信号**: 业绩下修/大股东减持/技术破位需重新评估

### 复盘与迭代

- 买入后每周复盘，检查五维信号是否有变化
- 若核心逻辑被破坏（业绩增速下滑/行业政策转向），果断止损
- 若走势与预期不符，检查分析框架是否有遗漏，再调整判断
""")


def run_analysis(ts_code, trade_date=None, save_md=False):
    """运行完整分析"""
    script_dir = os.path.dirname(os.path.abspath(__file__))
    skill_dir = os.path.dirname(script_dir)
    
    # 如果指定保存MD文件，创建输出捕获器
    output_capture = None
    md_file_path = None
    if save_md:
        # 生成文件名: [股票代码]_[股票名称]_深度研报_YYYYMMDD.md
        date_str = trade_date if trade_date else datetime.now().strftime('%Y%m%d')
        # 提取股票代码（去掉.SZ/.SH后缀）
        code_short = ts_code.split('.')[0]
        # 保存到 reports/ 子目录
        reports_dir = os.path.join(skill_dir, 'reports')
        os.makedirs(reports_dir, exist_ok=True)
        md_file_path = os.path.join(reports_dir, f'{code_short}_深度研报_{date_str}.md')
        output_capture = OutputCapture(save_to_file=True, file_path=md_file_path)
        # 重定向标准输出
        old_stdout = sys.stdout
        sys.stdout = output_capture
    
    try:
        print(f"# 🔍 A股深度投研分析报告\n")
        print(f"- **股票代码**: {ts_code}")
        print(f"- **报告日期**: {trade_date if trade_date else datetime.now().strftime('%Y%m%d')}\n")
        print("> **分析框架**：宏观分析 → 基本面分析 → 消息面分析 → 技术面分析 → 投研结论\n")
        print("---\n")
        
        # 保存各维度原始输出
        outputs = {}
        
        # 一、宏观分析
        print("\n## 一、宏观分析\n")
        print("### 1.1 市场走势（A股+行业指数）\n")
        fund_output = run_script_and_capture('fundamental_analysis.py', ts_code, trade_date)
        # 精确提取宏观分析部分（只保留【大盘走势】到【宏观关注点】的内容）
        if '【大盘走势】' in fund_output:
            # 找到【大盘走势】的位置
            macro_start = fund_output.find('【大盘走势】')
            macro_section = fund_output[macro_start:]
            # 在多个可能的结束点截断
            end_markers = ['📈 公司基本面', '【公司概况】', '---\n📈 公司']
            for marker in end_markers:
                if marker in macro_section:
                    macro_section = macro_section.split(marker)[0]
                    break
            print(macro_section)
        else:
            print(fund_output)
        
        # 添加行业指数走势 - 自动获取
        print_industry_index_section(ts_code)
        
        print("\n### 1.2 政策分析\n")
        print("> ⚠️ **此部分需Agent通过 `kimi_search` 补充最新政策与深度解读**\n")
        print("**建议搜索关键词**：")
        print(f"- `{ts_code.split('.')[0]} 政策 2025`")
        print(f"- 行业相关政策、目标、短中期影响")
        outputs['fundamental'] = fund_output
        
        # 二、基本面分析
        print("\n## 二、基本面分析\n")
        
        # 2.1 商业模式
        print("\n### 2.1 商业模式深度解析\n")
        business_output = run_script_and_capture('business_analysis.py', ts_code, trade_date)
        # 提取商业模式部分
        if '🏢 商业模式深度分析' in business_output:
            biz_section = business_output.split('🏢 商业模式深度分析')[1]
            if '🔗 产业链深度分析' in biz_section:
                biz_section = biz_section.split('🔗 产业链深度分析')[0]
            print(biz_section)
        else:
            print(business_output)
        
        # 2.2 竞争格局
        print("\n### 2.2 竞争格局全面评估\n")
        if '⚔️ 竞争格局深度分析' in business_output:
            comp_section = business_output.split('⚔️ 竞争格局深度分析')[1]
            if '📝 分析总结' in comp_section:
                comp_section = comp_section.split('📝 分析总结')[0]
            print(comp_section)
        else:
            print("> 竞争格局分析数据未完整生成")
        
        # 2.3 产业链分析（作为竞争格局的补充）
        print("\n### 2.3 产业链深度分析\n")
        if '🔗 产业链深度分析' in business_output:
            chain_section = business_output.split('🔗 产业链深度分析')[1]
            if '【商业模式健康度评估】' in chain_section:
                chain_section = chain_section.split('【商业模式健康度评估】')[0]
            print(chain_section)
        else:
            print("> ⚠️ 产业链分析数据未完整生成")
        outputs['business'] = business_output
        
        # 2.4 市场预期分析
        print("\n### 2.4 市场预期深度分析\n")
        print("> ⚠️ **此部分需Agent通过网络搜索验证后补充**\n")
        print("**验证要点**：")
        print("- 概念题材是否属实")
        print("- 业绩爆发预期是否有订单/产能支撑")
        print("- 供应链卡位预期是否真实")
        print("\n**输出标准**：")
        print("| 信息类型 | 处理方式 | 输出标识 |")
        print("|----------|----------|----------|")
        print("| 已验证信息 | 正常输出 | ✅ 已验证 + 信息来源 |")
        print("| 未验证线索 | 仅作查证方向 | ⚠️ 待验证 |")
        print("| 市场传闻 | 明确标注 | ❓ 未证实 |")
        
        # 运行估值预期分析脚本获取基础数据
        expectation_output = run_script_and_capture('market_expectation_analysis.py', ts_code, trade_date)
        # 提取估值评估部分
        if '【估值评估】' in expectation_output:
            print("\n**估值评估（脚本生成）**：\n")
            for line in expectation_output.split('\n'):
                if '【估值评估】' in line or '当前状态:' in line or '评估说明:' in line or '合理PE区间:' in line:
                    print(line)
        outputs['expectation'] = expectation_output
        
        # 三、消息面分析
        print("\n## 三、消息面分析\n")
        
        # 3.1 业绩公告
        print("\n### 3.1 业绩公告\n")
        news_output = run_script_and_capture('news_analysis.py', ts_code, trade_date)
        # 提取业绩快报、业绩预告
        if '【业绩快报' in news_output or '【业绩预告' in news_output:
            for line in news_output.split('\n'):
                if '【业绩快报' in line or '【业绩预告' in line or '公告日期:' in line or '预告类型:' in line or '预告摘要:' in line:
                    print(line)
        else:
            print(news_output)
        outputs['news'] = news_output
        
        # 3.2 资本运作
        print("\n### 3.2 资本运作（增减持/回购/定增/激励）\n")
        if '【增减持情况】' in news_output or '【回购情况】' in news_output:
            for line in news_output.split('\n'):
                if '【增减持情况】' in line or '【回购情况】' in line or '【限售股解禁】' in line or '近3个月' in line:
                    print(line)
        else:
            print("> 近3个月暂无相关资本运作数据")
        
        # 3.3 重大事项
        print("\n### 3.3 重大事项\n")
        print("> ⚠️ **此部分需Agent通过 `kimi_search` 补充最新重大事项**\n")
        print("**关注要点**：")
        print("- 限售股解禁时间表")
        print("- 重大合同/订单公告")
        print("- 高管变动")
        print("- 诉讼/问询")
        
        # 3.4 行业个股新闻
        print("\n### 3.4 行业个股新闻\n")
        print("> ⚠️ **此部分需Agent通过 `kimi_search` 补充**\n")
        print("**建议搜索关键词**：")
        print(f"- `{ts_code.split('.')[0]} 新闻 2025`")
        print(f"- 行业政策/供需/价格变化")
        
        # 3.5 研报交叉验证
        print("\n### 3.5 研报交叉验证（近一年）\n")
        report_output = run_script_and_capture('report_analysis.py', ts_code, trade_date)
        print(report_output)
        outputs['report'] = report_output
        
        # 四、技术面分析
        print("\n## 四、技术面分析\n")
        
        # 4.1 技术指标分析（基于数据计算）
        print("\n### 4.1 📊 技术指标分析（基于数据计算）\n")
        tech_output = run_script_and_capture('technical_analysis.py', ts_code, trade_date)
        print(tech_output)
        outputs['technical'] = tech_output
        
        # 4.2 视觉分析占位符（必须由Agent手动补充）
        print("\n### 4.2 👁️ 视觉分析（基于K线图人工解读）\n")
        print("> ⚠️ **此部分需Agent手动补充**\n")
        print("> 请执行以下步骤完成视觉分析：\n")
        print("> 1. 读取K线图：`read charts/{}_kline.png`".format(ts_code.replace('.', '_')))
        print("> 2. 基于图片内容，按以下七维度框架输出分析：\n")
        print("**视觉分析七维度框架**：")
        print("- **趋势结构**：整体方向、通道形态、高低点排列")
        print("- **均线系统**：排列形态（多头/空头/纠缠）、均线乖离")
        print("- **支撑与压力**：图表中的水平支撑/压力线、关键价位")
        print("- **形态识别**：经典形态（头肩、双顶/底、三角形等）")
        print("- **MACD动能**：DIF/DEA位置、柱状图变化、背离信号")
        print("- **成交量分析**：量价配合、关键位置量能")
        print("- **关键视觉信号**：⚠️警示/🎯关键位/✅确认信号")
        print("\n---\n")
        
        # 五、投研结论
        print("\n## 五、投研结论")
        print("\n")
        metrics = extract_key_metrics(outputs)
        conclusion = generate_conclusion(metrics)
        print_conclusion_section(conclusion)
        
        # 六、数据来源与免责声明
        print(f"""
## 六、数据来源与免责声明

