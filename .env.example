# 复制为 .env 并填写（勿提交 .env）

# 拉行情 / 基本面（仅 fetch_* / update_panel 需要；已有 panel 或开源包则可不填）
TUSHARE_TOKEN=
TUSHARE_HTTP_URL=https://tushare.citydata.club

# 因子挖掘（uv sync --extra mining）
# 也可用 scripts/run_factor_mining.sh：读 AX_LLM_API_KEY / LITELLM_API_KEY，并默认走 LiteLLM
OPENAI_API_KEY=
OPENAI_API_BASE=https://litellm.spaccez.com/v1
MODEL=deepseek-v4-flash
# MAX_PARALLEL_EVAL=4
